<!DOCTYPE html>
<html lang="az">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tural & Günel — Toy Dəvətnaməsi</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Marcellus&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --white:#ffffff;
    --blue:#1f6fb2;
    --blue-soft:#eaf3fb;
    --purple:#6a3fa0;
    --purple-soft:#f2ecfa;
    --red:#d92b3f;
    --ink:#231c3d;
    --ink-soft:#635a7d;
    --line: rgba(106,63,160,0.22);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--white);
    color:var(--ink);
    font-family:'Jost', sans-serif;
    font-weight:400;
    overflow-x:hidden;
  }
  ::selection{background:var(--purple); color:#fff;}

  .band-top, .band-bottom{
    position:fixed; left:0; right:0; height:6px; z-index:40;
    background:linear-gradient(90deg, var(--blue) 0%, var(--purple) 50%, var(--red) 100%);
  }
  .band-top{top:0;} .band-bottom{bottom:0;}

  .stage{position:relative; z-index:2;}

  .music-btn{
    position:fixed; top:26px; right:22px; z-index:50;
    width:52px; height:52px; border-radius:50%;
    border:1.5px solid var(--purple);
    background:#fff;
    box-shadow:0 4px 16px rgba(106,63,160,0.18);
    display:flex; align-items:center; justify-content:center;
    cursor:pointer;
    transition:transform .2s ease, box-shadow .25s ease;
  }
  .music-btn:hover{transform:scale(1.06); box-shadow:0 6px 22px rgba(217,43,63,0.22);}
  .music-btn svg{width:20px; height:20px; stroke:var(--purple); fill:none;}
  .music-bars{display:flex; align-items:flex-end; gap:2px; height:14px;}
  .music-bars span{
    width:3px; background:var(--red); border-radius:1px;
    animation:bar 0.9s ease-in-out infinite;
    animation-play-state:paused;
    height:4px;
  }
  .playing .music-bars span{animation-play-state:running;}
  .music-bars span:nth-child(1){animation-delay:0s;}
  .music-bars span:nth-child(2){animation-delay:.15s;}
  .music-bars span:nth-child(3){animation-delay:.3s;}
  .music-bars span:nth-child(4){animation-delay:.45s;}
  @keyframes bar{0%,100%{height:4px;} 50%{height:15px;}}

  .hero{
    min-height:100svh;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center;
    padding:60px 24px;
    position:relative;
    background:
      radial-gradient(circle at 12% 10%, var(--blue-soft) 0%, transparent 46%),
      radial-gradient(circle at 88% 18%, var(--purple-soft) 0%, transparent 42%),
      radial-gradient(circle at 50% 95%, rgba(217,43,63,0.06) 0%, transparent 40%);
  }
  .hero .frame{
    border:1.5px solid var(--line);
    border-radius:2px;
    padding:60px 46px;
    position:relative;
    max-width:640px;
  }
  .hero .frame::before, .hero .frame::after{
    content:''; position:absolute; width:26px; height:26px;
    border:1.5px solid var(--purple);
  }
  .hero .frame::before{top:-8px; left:-8px; border-right:none; border-bottom:none;}
  .hero .frame::after{bottom:-8px; right:-8px; border-left:none; border-top:none;}
  .hero .eyebrow-orn{
    font-family:'Cormorant Garamond', serif; font-style:italic; font-size:1.05rem;
    color:var(--red); letter-spacing:0.05em; margin-bottom:20px;
    opacity:0; animation:rise 1s ease forwards; animation-delay:.1s;
  }
  .hero h1{
    font-family:'Marcellus', serif;
    font-size:clamp(2.6rem, 8.6vw, 5rem);
    line-height:1.06;
    color:var(--ink);
    opacity:0; animation:rise 1.1s ease forwards; animation-delay:.35s;
  }
  .hero .name-a{color:var(--blue);}
  .hero .name-b{color:var(--purple);}
  .hero .amp{
    display:inline-block;
    font-family:'Cormorant Garamond', serif; font-style:italic;
    font-size:0.55em;
    color:var(--red);
    margin:0 14px;
  }
  .hero .date-line{
    margin-top:30px;
    font-family:'Cormorant Garamond', serif;
    font-size:1.15rem;
    letter-spacing:0.1em;
    color:var(--ink-soft);
    opacity:0; animation:rise 1s ease forwards; animation-delay:.6s;
  }
  .hero .date-line b{color:var(--purple); font-weight:600;}
  .hero .date-line .dot{color:var(--red); margin:0 8px;}
  @keyframes rise{from{opacity:0; transform:translateY(16px);} to{opacity:1; transform:translateY(0);}}
  .scroll-cue{
    margin-top:56px; font-size:.68rem; letter-spacing:.2em; color:var(--ink-soft);
    display:flex; flex-direction:column; align-items:center; gap:8px;
  }
  .scroll-cue .stick{width:1px; height:28px; background:linear-gradient(var(--purple), transparent); animation:cue 1.8s ease-in-out infinite;}
  @keyframes cue{0%{opacity:.25;} 50%{opacity:1;} 100%{opacity:.25;}}

  section{position:relative; padding:100px 24px; max-width:760px; margin:0 auto;}
  .section-label{
    text-align:center; font-family:'Cormorant Garamond', serif; font-style:italic;
    color:var(--red); font-size:1.05rem; margin-bottom:14px;
  }
  .section-title{
    text-align:center; font-family:'Marcellus', serif;
    font-size:clamp(1.8rem, 5vw, 2.5rem); color:var(--ink); margin-bottom:50px;
  }
  .tri-divider{display:flex; justify-content:center; gap:8px; margin-bottom:50px;}
  .tri-divider span{width:8px; height:8px; border-radius:50%;}
  .tri-divider span:nth-child(1){background:var(--blue);}
  .tri-divider span:nth-child(2){background:var(--purple);}
  .tri-divider span:nth-child(3){background:var(--red);}

  .countdown{display:flex; justify-content:center; gap:clamp(12px, 3.6vw, 26px); flex-wrap:wrap;}
  .countdown .unit{
    text-align:center; width:92px; height:92px;
    border-radius:50%;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    border:2px solid var(--blue);
  }
  .countdown .unit:nth-child(2){border-color:var(--purple);}
  .countdown .unit:nth-child(3){border-color:var(--red);}
  .countdown .unit:nth-child(4){border-color:var(--purple);}
  .countdown .num{font-family:'Marcellus', serif; font-size:1.55rem; color:var(--ink); line-height:1;}
  .countdown .lbl{margin-top:6px; font-size:.62rem; letter-spacing:.12em; color:var(--ink-soft);}

  .story-wrap{
    background:var(--purple-soft); border-radius:4px; padding:48px 40px; text-align:center;
    position:relative;
  }
  .story-wrap .qmark{
    font-family:'Marcellus', serif; font-size:3rem; color:var(--purple); line-height:1; display:block; margin-bottom:6px;
  }
  .story-text{
    font-family:'Cormorant Garamond', serif; font-size:1.3rem;
    line-height:1.8; color:var(--ink);
  }

  .timeline{position:relative; padding-left:0;}
  .timeline::before{
    content:''; position:absolute; left:50%; top:0; bottom:0; width:2px;
    background:linear-gradient(var(--blue), var(--purple), var(--red));
    transform:translateX(-50%);
  }
  @media (max-width:620px){ .timeline::before{left:22px;} }
  .t-item{
    display:flex; align-items:flex-start; justify-content:center; gap:34px;
    margin-bottom:48px; position:relative;
  }
  .t-item:nth-child(even){flex-direction:row-reverse;}
  @media (max-width:620px){
    .t-item, .t-item:nth-child(even){flex-direction:row; padding-left:52px;}
  }
  .t-dot{
    width:14px; height:14px; border-radius:50%; background:var(--white);
    border:2.5px solid var(--purple); flex-shrink:0; margin-top:6px; z-index:2;
  }
  @media (max-width:620px){ .t-dot{position:absolute; left:16px; top:0;} }
  .t-content{max-width:280px;}
  .t-item:nth-child(1) .t-dot{border-color:var(--blue);}
  .t-item:nth-child(2) .t-dot{border-color:var(--purple);}
  .t-item:nth-child(3) .t-dot{border-color:var(--red);}
  .t-item:nth-child(4) .t-dot{border-color:var(--purple);}
  .t-content h3{font-family:'Marcellus', serif; font-size:1.1rem; color:var(--ink); margin-bottom:8px;}
  .t-content p{font-size:.92rem; line-height:1.6; color:var(--ink-soft);}
  .t-content a{color:var(--blue); text-decoration:none; border-bottom:1px solid var(--line);}

  .rsvp-box{
    position:relative; padding:3px; border-radius:16px;
    background:linear-gradient(120deg, var(--blue), var(--purple), var(--red));
  }
  .rsvp-inner{background:#fff; border-radius:14px; padding:42px 30px; text-align:center;}
  .rsvp-inner p{color:var(--ink-soft); margin-bottom:26px; font-size:.98rem;}
  .rsvp-form{display:flex; flex-direction:column; gap:16px; max-width:360px; margin:0 auto;}
  .rsvp-form input, .rsvp-form select{
    background:transparent; border:none; border-bottom:1px solid var(--line);
    color:var(--ink); font-family:'Jost', sans-serif; font-size:.95rem;
    padding:10px 4px; outline:none; transition:border-color .25s ease;
  }
  .rsvp-form input::placeholder{color:#9992ac;}
  .rsvp-form input:focus, .rsvp-form select:focus{border-color:var(--purple);}
  .rsvp-form select option{background:#fff; color:var(--ink);}
  .rsvp-btn{
    margin-top:10px; padding:13px 20px; border:none; border-radius:6px;
    background:linear-gradient(90deg, var(--purple), var(--red));
    color:#fff; letter-spacing:.1em; font-size:.8rem; font-weight:500;
    cursor:pointer; transition:opacity .25s ease, transform .2s ease;
  }
  .rsvp-btn:hover{opacity:.9; transform:translateY(-1px);}
  .rsvp-confirm{
    display:none; color:var(--purple); font-family:'Cormorant Garamond', serif;
    font-style:italic; font-size:1.1rem; margin-top:18px;
  }

  footer{
    text-align:center; padding:60px 24px 90px; color:var(--ink-soft);
    font-family:'Cormorant Garamond', serif; font-style:italic; font-size:.95rem;
  }
  .fmono{font-family:'Marcellus', serif; color:var(--purple); font-style:normal; letter-spacing:.02em;}
</style>
</head>
<body>

<div class="band-top"></div>
<div class="band-bottom"></div>

<button class="music-btn" id="musicBtn" aria-label="Musiqi">
  <svg id="musicIcon" viewBox="0 0 24 24" stroke-width="1.4"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
</button>

<div class="stage">

  <section class="hero" style="padding-top:0;">
    <div class="frame">
      <div class="eyebrow-orn">Sizi toy şənliyimizə dəvət edirik</div>
      <h1><span class="name-a">Tural</span><span class="amp">&amp;</span><span class="name-b">Günel</span></h1>
      <div class="date-line">
        <b>22 May 2027</b> <span class="dot">·</span> Bakı
      </div>
    </div>
    <div class="scroll-cue"><div class="stick"></div>AŞAĞI SÜRÜŞDÜRÜN</div>
  </section>

  <section>
    <div class="section-label">Vaxt yaxınlaşır</div>
    <div class="section-title">Toy gününə qalan vaxt</div>
    <div class="countdown" id="countdown">
      <div class="unit"><div class="num" id="cd-days">--</div><div class="lbl">GÜN</div></div>
      <div class="unit"><div class="num" id="cd-hours">--</div><div class="lbl">SAAT</div></div>
      <div class="unit"><div class="num" id="cd-min">--</div><div class="lbl">DƏQİQƏ</div></div>
      <div class="unit"><div class="num" id="cd-sec">--</div><div class="lbl">SANİYƏ</div></div>
    </div>
  </section>

  <section>
    <div class="story-wrap">
      <span class="qmark">"</span>
      <p class="story-text">
        İki qəlbin bir yol seçdiyi bu xüsusi gündə sevincimizi sizinlə bölüşmək istəyirik.
        Sizin iştirakınız bu günü bizim üçün daha da mənalı edəcək. Gəlin, birlikdə qeyd edək!
      </p>
    </div>
  </section>

  <section style="max-width:820px;">
    <div class="section-label">Məlumat</div>
    <div class="section-title">Tədbirin təfərrüatları</div>
    <div class="timeline">
      <div class="t-item">
        <div class="t-dot"></div>
        <div class="t-content">
          <h3>⛪ Nikah mərasimi</h3>
          <p>22 May 2027, saat 17:00<br>Bakı, Şəhər Sarayı</p>
        </div>
      </div>
      <div class="t-item">
        <div class="t-dot"></div>
        <div class="t-content">
          <h3>🥂 Toy ziyafəti</h3>
          <p>22 May 2027, saat 19:00<br>"Gülüstan" Sarayı, Bakı</p>
        </div>
      </div>
      <div class="t-item">
        <div class="t-dot"></div>
        <div class="t-content">
          <h3>👗 Geyim tərzi</h3>
          <p>Zərif axşam geyimi<br>Əsas rənglər: mavi, bənövşəyi və qırmızı</p>
        </div>
      </div>
      <div class="t-item">
        <div class="t-dot"></div>
        <div class="t-content">
          <h3>📍 Ünvan</h3>
          <p>Neftçilər prospekti, Bakı<br><a href="#">Xəritədə göstər</a></p>
        </div>
      </div>
    </div>
  </section>

  <section style="max-width:600px;">
    <div class="section-label">Cavabınızı gözləyirik</div>
    <div class="section-title">İştirakınızı təsdiqləyin</div>
    <div class="rsvp-box">
      <div class="rsvp-inner">
        <p>22 Aprel 2027 tarixinə qədər cavabınızı bildirməyinizi xahiş edirik.</p>
        <form class="rsvp-form" id="rsvpForm">
          <input type="text" id="rsvpName" placeholder="Ad və Soyad" required>
          <select id="rsvpAttend" required>
            <option value="" disabled selected>İştirak edəcəksiniz?</option>
            <option>Bəli, məmnuniyyətlə gələcəyəm</option>
            <option>Təəssüf ki, gələ bilməyəcəyəm</option>
          </select>
          <input type="number" id="rsvpCount" min="1" placeholder="Neçə nəfər gələcəksiniz?">
          <button type="submit" class="rsvp-btn">CAVABI GÖNDƏR</button>
        </form>
        <div class="rsvp-confirm" id="rsvpConfirm">Təşəkkür edirik! WhatsApp açılır, mesajı göndərməyi unutmayın. ♥</div>
      </div>
    </div>
  </section>

  <footer>
    Sevgi ilə gözləyirik ·<span class="fmono"> Tural &amp; Günel</span>
  </footer>

</div>

<script>
  const weddingDate = new Date("2027-05-22T17:00:00");
  function tick(){
    const now = new Date();
    let diff = weddingDate - now;
    if(diff < 0) diff = 0;
    const d = Math.floor(diff/(1000*60*60*24));
    const h = Math.floor((diff/(1000*60*60))%24);
    const m = Math.floor((diff/(1000*60))%60);
    const s = Math.floor((diff/1000)%60);
    document.getElementById('cd-days').textContent = d;
    document.getElementById('cd-hours').textContent = String(h).padStart(2,'0');
    document.getElementById('cd-min').textContent = String(m).padStart(2,'0');
    document.getElementById('cd-sec').textContent = String(s).padStart(2,'0');
  }
  tick();
  setInterval(tick, 1000);

  // ---- RSVP → WhatsApp ----
  // ⚠️ Bura öz WhatsApp nömrənizi ölkə kodu ilə (boşluqsuz, "+" işarəsiz) yazın.
  // Nümunə: Azərbaycan nömrəsi 050 123 45 67 üçün "994501234567"
  const WHATSAPP_NUMBER = "994501234567";

  document.getElementById('rsvpForm').addEventListener('submit', function(e){
    e.preventDefault();

    const name = document.getElementById('rsvpName').value.trim();
    const attend = document.getElementById('rsvpAttend').value;
    const count = document.getElementById('rsvpCount').value.trim();

    let message = `Salam! Toy dəvətnaməsinə cavabımı bildirmək istəyirəm.\n\n`;
    message += `Ad və Soyad: ${name}\n`;
    message += `İştirak: ${attend}\n`;
    if(count){ message += `Qonaq sayı: ${count}\n`; }

    const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
    window.open(url, '_blank');

    this.style.display = 'none';
    document.getElementById('rsvpConfirm').style.display = 'block';
  });

  let audioCtx, isPlaying = false, master;
  const btn = document.getElementById('musicBtn');
  const icon = document.getElementById('musicIcon');

  function buildIcon(playing){
    icon.innerHTML = playing
      ? '<rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect>'
      : '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>';
  }

  const scale = [261.63, 293.66, 329.63, 392.00, 440.00, 523.25];
  let stepIndex = 0;
  let loopId;

  function playNote(freq, time, dur){
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(freq, time);
    gain.gain.setValueAtTime(0, time);
    gain.gain.linearRampToValueAtTime(0.09, time + 0.15);
    gain.gain.exponentialRampToValueAtTime(0.001, time + dur);
    osc.connect(gain).connect(master);
    osc.start(time);
    osc.stop(time + dur + 0.05);
  }

  function scheduleLoop(){
    const now = audioCtx.currentTime;
    const note = scale[stepIndex % scale.length];
    playNote(note, now, 2.2);
    if(stepIndex % 3 === 0){
      playNote(note/2, now, 3.2);
    }
    stepIndex++;
    loopId = setTimeout(scheduleLoop, 900);
  }

  btn.addEventListener('click', async () => {
    if(!audioCtx){
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      master = audioCtx.createGain();
      master.gain.value = 0.6;
      master.connect(audioCtx.destination);
    }
    if(audioCtx.state === 'suspended') await audioCtx.resume();

    isPlaying = !isPlaying;
    btn.classList.toggle('playing', isPlaying);
    buildIcon(isPlaying);

    if(isPlaying){
      stepIndex = 0;
      scheduleLoop();
    } else {
      clearTimeout(loopId);
    }
  });
</script>

</body>
</html>
